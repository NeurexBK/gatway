{
  "name": "solana-fiat-gateway",
  "version": "1.0.0",
  "description": "Gateway descentralizado de pagamentos: fiat (EUR/USD/BRL) -> USDC -> SOL -> split por basis points",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "src/database/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "vercel-build": "node scripts/set-db-provider.js postgresql && prisma generate && tsc -p tsconfig.check.json --noEmit",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:sqlite": "node scripts/set-db-provider.js sqlite && prisma generate",
    "db:postgres": "node scripts/set-db-provider.js postgresql && prisma generate",
    "keygen": "tsx scripts/keygen.ts",
    "sign-webhook": "tsx scripts/sign-webhook.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "axios": "^1.7.9",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
