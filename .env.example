# ─────────────────────────────────────────────────────────────
#  Solana Fiat Gateway — variáveis de ambiente
#  Copie para `.env` e preencha. NUNCA comite o .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Solana RPC (Helius / QuickNode recomendados: precisa de rate limit alto) ──
# Helius:    https://mainnet.helius-rpc.com/?api-key=SEU_API_KEY
# QuickNode: https://xxxxx.solana-mainnet.quiknode.pro/xxxxxxxx/
RPC_ENDPOINT=https://api.devnet.solana.com

# Endpoint opcional dedicado ao envio de txs (Helius "staked connections" etc).
# Se vazio, usa RPC_ENDPOINT.
RPC_SEND_ENDPOINT=

# ── Carteira Vault (recebe o USDC do on-ramp, assina swap + distribuição) ─────
# Aceita base58 (formato Phantom) OU array JSON de 64 bytes (formato solana-keygen).
# Gere uma nova com: npm run keygen
VAULT_PRIVATE_KEY=

# ── Webhook do provedor fiat (SpherePay / MoonPay) ────────────────────────────
FIAT_PROVIDER=spherepay
FIAT_PROVIDER_SECRET=whsec_placeholder_troque_isto
# Janela de tolerância do timestamp da assinatura, em segundos (anti-replay).
WEBHOOK_TOLERANCE_SECONDS=300

# ── Painel administrativo (GET /admin) ────────────────────────────────────────
# Protege /admin/api/*. Mínimo 16 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Autentica o cron EXTERNO em /admin/cron/distribute (Vercel Cron manda
# Authorization: Bearer). Só necessário onde o agendador in-process não roda.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Libera a pipeline que move dinheiro (swap + liquidação).
# Vazio = ligada em host persistente, DESLIGADA em serverless (os locks de
# concorrência são in-process). Ver DEPLOY.md antes de forçar true.
ALLOW_PIPELINE=

# ── Destinatários do split — SEED APENAS ──────────────────────────────────────
# Usado só na primeira subida, para popular a tabela `Recipient`. Depois disso
# a fonte de verdade é o banco, editável em /admin.
# A soma dos bps DEVE ser exatamente 10000 (100%).
RECIPIENTS_JSON='[{"label":"Carteira A","address":"11111111111111111111111111111112","bps":5000},{"label":"Carteira B","address":"11111111111111111111111111111113","bps":3000},{"label":"Carteira C","address":"11111111111111111111111111111114","bps":2000}]'

# ── Swap (Jupiter Aggregator) ─────────────────────────────────────────────────
# ATENÇÃO: o host clássico do v6 (quote-api.jup.ag) foi RETIRADO — não resolve
# mais em DNS. O contrato é idêntico (/quote e /swap, mesmos campos); só o host
# mudou. Verificado em 13/08/2026:
#   lite-api.jup.ag/swap/v1  -> tier público, sem chave (default)
#   api.jup.ag/swap/v1       -> tier com API key, rate limit maior
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# Mint do stablecoin creditado pelo on-ramp.
# USDC mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# USDT mainnet: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# USDC devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
INPUT_MINT_DECIMALS=6
# Slippage máximo aceito no swap (50 bps = 0.5%).
SLIPPAGE_BPS=50
# Prioridade (micro-lamports por CU) para o swap não ficar preso na fila.
PRIORITY_FEE_MICRO_LAMPORTS=200000
# Aborta o swap se o price impact passar disto (proteção contra pool raso/MEV).
MAX_PRICE_IMPACT_BPS=300

# ── Agregador de taxas dos on-ramps ───────────────────────────────────────────
# ATENÇÃO: nenhum destes adapters foi verificado contra a API real (o projeto
# não tem chaves). Todos vêm desligados. Ao ligar, compare o costBps calculado
# com o extrato real do provedor antes de confiar em produção.
FEE_CACHE_TTL_MS=300000

MOONPAY_ENABLED=false
MOONPAY_API_KEY=
MOONPAY_API_BASE=https://api.moonpay.com

TRANSAK_ENABLED=false
TRANSAK_API_KEY=
TRANSAK_API_BASE=https://api.transak.com

RAMP_ENABLED=false
RAMP_API_KEY=
RAMP_API_BASE=https://api.ramp.network

# SpherePay: adapter não implementado (sem endpoint de cotação público
# verificável). Ligar aqui não adiciona o provedor ao ranking.
SPHEREPAY_ENABLED=false
SPHEREPAY_API_KEY=
SPHEREPAY_API_BASE=https://api.spherepay.co

# ── Reservas e limites de segurança ───────────────────────────────────────────
# Lamports que ficam sempre no vault para pagar fees das próximas txs.
FEE_RESERVE_LAMPORTS=10000000
# Valor mínimo por destinatário (abaixo disto a ordem falha em vez de queimar fee).
# 890880 = rent-exempt mínimo de uma conta de sistema.
MIN_TRANSFER_LAMPORTS=890880
# Nº máximo de transferências por transação (limite prático de tamanho da tx).
MAX_TRANSFERS_PER_TX=18
# Nº máximo de tentativas por etapa antes de marcar a ordem como FAILED.
MAX_ATTEMPTS=3
# Timeout (ms) para o USDC do on-ramp aparecer no vault.
DEPOSIT_WAIT_TIMEOUT_MS=180000
# Teto por ordem em base units do INPUT_MINT (50.000 USDC com 6 decimais).
# Limita o dano de um evento forjado ou de um bug de parsing de valor.
MAX_ORDER_INPUT_RAW=50000000000

# ─────────────────────────────────────────────────────────────
#  Parâmetros editáveis no admin (estes ficam no BANCO, não aqui):
#    • horário/timezone da distribuição diária do lucro
#    • lucro mínimo por execução
#    • margem, piso e teto da taxa cobrada ao cliente
#    • carteiras e porcentagens do split
#  Defaults iniciais: 00:00 UTC, margem 150 bps, mínimo 0,005 SOL.
# ─────────────────────────────────────────────────────────────

# ── Prisma / SQLite (dev) ─────────────────────────────────────────────────────
DATABASE_URL="file:./gateway.db"
